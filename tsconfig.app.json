{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    // "moduleResolution": "node",        // ✅ Important for node_modules resolution
    // "baseUrl": ".",                    // ✅ Required for @/ style imports
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "esModuleInterop": true,          // ✅ Important for named imports
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src"]
}
